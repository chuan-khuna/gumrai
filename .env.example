# Copy to .env.local, then fill in SUPABASE_SECRET_KEY.
# Start local Supabase (bun run db:start), run bunx supabase status,
# and copy its SECRET_KEY value here. It only works against the local Docker stack.
SUPABASE_URL=http://127.0.0.1:54321
# The CLI's fixed local PUBLISHABLE_KEY. Pages and actions use it with the Seller's session;
# row-level security limits it to that Seller's rows.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Bypasses row-level security. Tests and admin-only operations only.
SUPABASE_SECRET_KEY=
# Sign in with Discord. From your own Discord Application (docs/documents/ONBOARDING.md,
# "Set up Discord sign-in"). Keep the real values only in .env.local, which git ignores.
# `bun run db:start` passes them to local Supabase; restart it (db:stop, db:start) after a change.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
