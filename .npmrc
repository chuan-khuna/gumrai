# bun is this project's package manager. See CLAUDE.md.
# npm is configured here only so that an accidental `npm install` is not a
# security downgrade. It cannot enforce everything bunfig.toml does.

# Block dependency lifecycle scripts. npm runs them by default; bun does not.
# This is the single largest supply-chain hole in npm and the main reason bun wins here.
ignore-scripts=true

# Pin exact versions, matching bunfig's `exact = true`.
save-exact=true

engine-strict=true
audit-level=moderate
fund=false

# NOTE: npm has no equivalent of bun's `minimumReleaseAge`. Its only comparable
# control is `--before=<fixed date>`, which goes stale the moment it is written.
# An `npm install` therefore CAN pull a package published minutes ago.
# If you installed with npm, delete node_modules and reinstall with bun.
